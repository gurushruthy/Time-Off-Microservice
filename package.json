{
  "name": "time-off-microservice",
  "version": "1.0.0",
  "description": "Time-Off Microservice for ReadyOn AI",
  "scripts": {
    "build": "nest build time-off",
    "build:mock-hcm": "nest build mock-hcm",
    "start": "node dist/src/main",
    "start:dev": "nest start time-off --watch",
    "start:mock-hcm": "nest start mock-hcm --watch",
    "test": "jest --config jest.config.js --runInBand",
    "test:unit": "jest --config jest.config.js --testPathPattern=test/unit --runInBand",
    "test:integration": "jest --config jest.config.js --testPathPattern=test/integration --runInBand",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand --forceExit"
  },
  "dependencies": {
    "@nestjs/axios": "^3.0.2",
    "@nestjs/common": "^10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.8",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/schedule": "^4.0.2",
    "@nestjs/typeorm": "^10.0.2",
    "axios": "^1.6.8",
    "better-sqlite3": "^9.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cron": "^3.1.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/testing": "^10.3.8",
    "@types/better-sqlite3": "^7.6.9",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  }
}
